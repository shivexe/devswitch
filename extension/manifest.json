{
  "manifest_version": 3,
  "name": "DevSwitch",
  "version": "1.0.0",
  "description": "Fill verification codes from your paired phone.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
